# 复制为 .env.local 并填入真实值；或在应用「设置」页内配置（存本地数据库，无需改文件）。
# AI 对话（OpenAI 兼容协议）
MINE_BRAIN_AI_BASE_URL=
MINE_BRAIN_AI_API_KEY=
MINE_BRAIN_AI_MODEL=x-preview-f-free

# 向量检索（阿里云百炼 embedding，OpenAI 兼容端点）
MINE_BRAIN_EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MINE_BRAIN_EMBED_MODEL=qwen3.7-text-embedding
MINE_BRAIN_EMBED_API_KEY=
MINE_BRAIN_EMBED_DIMENSIONS=1024

# 联网搜索（Exa，https://dashboard.exa.ai 注册即送 $20 + 每月 $10 免费额度；也可在设置页配置）
MINE_BRAIN_SEARCH_BASE_URL=https://api.exa.ai
MINE_BRAIN_SEARCH_API_KEY=
