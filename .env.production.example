# 复制为 .env.production 并填入真实值（服务器上，与 docker-compose.yml 同目录；已被 gitignore，不会提交）
# 注意：也可以不配任何 AI 变量，首次启动后在应用「设置」页内配置（存本地数据库）。

# AI 对话（OpenAI 兼容协议）
MINE_BRAIN_AI_BASE_URL=
MINE_BRAIN_AI_API_KEY=
MINE_BRAIN_AI_MODEL=

# 向量检索（OpenAI 兼容 embeddings 端点，如阿里云百炼）
MINE_BRAIN_EMBED_BASE_URL=
MINE_BRAIN_EMBED_MODEL=
MINE_BRAIN_EMBED_API_KEY=
MINE_BRAIN_EMBED_DIMENSIONS=1024

# 可选：覆盖数据目录（默认容器内 /app/data，已挂载卷，无需改动）
# MINE_BRAIN_DATA_DIR=/app/data
